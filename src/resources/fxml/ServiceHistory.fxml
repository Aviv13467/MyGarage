<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" styleClass="menu-button" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ServiceHistoryController">
   <top>
      <VBox alignment="TOP_CENTER" prefHeight="69.0" prefWidth="560.0" BorderPane.alignment="CENTER">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Service History" />
            <TextField fx:id="searchField" promptText="Enter License Number or Model Name" />
         </children>
      </VBox>
   </top>
   <center>
      <TableView fx:id="historyTable" prefHeight="200.0" prefWidth="560.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="idColumn" prefWidth="43.0" text="ID" />
          <TableColumn fx:id="licenseColumn" prefWidth="120.0" text="License Number" />
            <TableColumn fx:id="modelColumn" prefWidth="126.0" text="Model Name" />
            <TableColumn fx:id="dateColumn" prefWidth="97.0" text="Date" />
            <TableColumn fx:id="mileageColumn" prefWidth="104.0" text="Mileage" />
            <TableColumn fx:id="costColumn" prefWidth="66.0" text="Cost" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER" prefHeight="37.0" prefWidth="560.0" spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#handleAddService" text="+" />
            <Button mnemonicParsing="false" onAction="#handleDeleteService" text="-" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
